APP_NAME="F5 Plan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.127.126.25
DB_PORT=3306
DB_DATABASE=f5plan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

F5AI_API_KEY=
F5AI_API_URL=https://api.f5ai.ru/v2
# Дефолт, если пользователь не выбрал модель в личном кабинете
F5AI_MODEL=gpt-5.5
F5AI_MODEL_LARGE=gpt-5.5
F5AI_TIMEOUT=300
F5AI_TIMEOUT_TZ_PLAN=600
# 0 = без лимита длины ответа ИИ
F5AI_MAX_TOKENS=0
F5AI_MAX_TOKENS_REPORT=0
F5AI_MAX_TOKENS_AMOCRM_AUDIT=0
F5AI_MAX_TOKENS_CHANGES=0
F5AI_MAX_TOKENS_MEETING=0
F5AI_STALE_MINUTES=8
F5AI_STALE_MINUTES_TZ_PLAN=30
# F5AI_SYNC_PROCESSING=true
# F5AI_PHP_BINARY=C:\OSPanel\modules\PHP-8.3\PHP\php.exe
# OCR для скриншотов в чате (tesseract). На Windows укажите полный путь к tesseract.exe.
# F5AI_OCR_BINARY=tesseract
# F5AI_OCR_LANGS=rus+eng
# F5AI_OCR_TIMEOUT=90
# Ставка часа для сметы этапов работ (₽), суммы кратны ей: 5100, 10200, 15300, 51000…
F5AI_WORK_STAGE_HOURLY_RATE=5100

# Google OAuth (Web application) for saving docs to the user's Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/google/callback"
